# Copy to .env and fill in. `.env` is gitignored; this file is not.
# pyqa calls load_dotenv() at import, so these are picked up automatically.

# --- Hosted providers -------------------------------------------------------
# Used by examples/openrouter.toml
OPENROUTER_API_KEY=sk-or-v1-...

# --- Generic / self-hosted --------------------------------------------------
# Used by pyqa.example.toml. A local vLLM usually ignores the key entirely,
# in which case any placeholder works.
PYQA_API_KEY=not-needed
PYQA_VISION_KEY=not-needed
